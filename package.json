{
  "name": "paperfold-flipbook",
  "version": "0.1.0",
  "description": "Framework-independent DOM/CSS page-turn engine with live geometric folds.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/paperfold.js",
  "module": "./lib/paperfold.js",
  "types": "./lib/types/index.d.ts",
  "style": "./lib/paperfold.css",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/paperfold.js"
    },
    "./react": {
      "types": "./lib/types/react.d.ts",
      "import": "./lib/react.js"
    },
    "./json": {
      "types": "./lib/types/json.d.ts",
      "import": "./lib/json.js"
    },
    "./pdf": {
      "types": "./lib/types/pdf.d.ts",
      "import": "./lib/pdf.js"
    },
    "./styles.css": "./lib/paperfold.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib",
    "examples",
    "docs",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "tsc --noEmit && vite build",
    "build:package": "node scripts/build-package.mjs",
    "test": "vitest run",
    "test:docs": "node scripts/check-docs.mjs",
    "test:browser": "set PLAYWRIGHT_BROWSERS_PATH=work\\playwright-browsers&& playwright test --grep-invert \"@visual|@performance\"",
    "test:visual": "set PLAYWRIGHT_BROWSERS_PATH=work\\playwright-browsers&& playwright test --grep @visual",
    "test:visual:update": "set PLAYWRIGHT_BROWSERS_PATH=work\\playwright-browsers&& playwright test --grep @visual --update-snapshots",
    "test:performance": "set PLAYWRIGHT_BROWSERS_PATH=work\\playwright-browsers&& playwright test --grep @performance",
    "test:firefox": "set PLAYWRIGHT_BROWSERS_PATH=work\\playwright-browsers&& set PAPERFOLD_FIREFOX=1&& playwright test --project=firefox",
    "check": "npm run test && npm run test:docs && npm run build && npm run build:package",
    "prepack": "npm run build:package"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=6.2.108 <7",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
