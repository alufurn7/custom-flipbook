{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "lib/types",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/index.ts",
    "src/json.ts",
    "src/pdf.ts",
    "src/react.tsx",
    "src/calibration.ts",
    "src/types.ts",
    "src/core/**/*.ts",
    "src/geometry/**/*.ts"
  ],
  "exclude": ["src/main.ts", "tests", "work", "dist", "lib"]
}
